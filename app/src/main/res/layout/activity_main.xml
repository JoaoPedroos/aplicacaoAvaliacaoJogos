<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/relativeLayout"

    android:layout_width="match_parent"

    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textView"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="@string/avalie_o_jogo_abaixo"
        app:layout_constraintBottom_toTopOf="@+id/imagem_jogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView

        android:id="@+id/imagem_jogo"

        android:layout_width="wrap_content"

        android:layout_height="0dp"

        android:contentDescription="@string/todo"

        android:src="@drawable/jogo_angry_bird"
        app:layout_constraintBottom_toTopOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />


    <TextView

        android:id="@+id/textView2"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:layout_marginBottom="1dp"

        android:text="@string/deixe_seu_voto"
        app:layout_constraintBottom_toTopOf="@+id/rtbvotacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imagem_jogo" />


    <RatingBar

        android:id="@+id/rtbvotacao"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:numStars="5"

        android:progressTint="#FFC107"
        android:progressBackgroundTint="#D3D3D3"
        app:layout_constraintBottom_toTopOf="@+id/txtstatus"
        app:layout_constraintStart_toStartOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />


    <TextView

        android:id="@+id/txtstatus"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:layout_marginStart="4dp"

        android:layout_marginBottom="416dp"
        android:text="@string/status"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/rtbvotacao"
        app:layout_constraintTop_toBottomOf="@+id/rtbvotacao" />


</androidx.constraintlayout.widget.ConstraintLayout>